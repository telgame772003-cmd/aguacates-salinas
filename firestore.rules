rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isAdminKeyActive(keyHash) {
      let keyDoc = getAfter(/databases/$(database)/documents/admin_keys/$(keyHash));
      return keyDoc != null && keyDoc.data.active == true;
    }

    function isDriverKeyActive(keyHash) {
      let keyDoc = getAfter(/databases/$(database)/documents/driver_keys/$(keyHash));
      return keyDoc != null && keyDoc.data.active == true;
    }

    function isWarehouseKeyActive(keyHash) {
      let keyDoc = getAfter(/databases/$(database)/documents/warehouse_keys/$(keyHash));
      return keyDoc != null && keyDoc.data.active == true;
    }

    function isSuperadminKeyActive(keyHash) {
      let keyDoc = getAfter(/databases/$(database)/documents/superadmin_keys/$(keyHash));
      return keyDoc != null && keyDoc.data.active == true;
    }

    function hasValidAdminProof() {
      let proofId = request.resource.data.proofId;
      return proofId is string
        && proofId.matches('^prf_.*')
        && getAfter(/databases/$(database)/documents/admin_proofs/$(proofId)).data.keyHash is string
        && isAdminKeyActive(getAfter(/databases/$(database)/documents/admin_proofs/$(proofId)).data.keyHash);
    }

    function hasValidDriverProof() {
      let proofId = request.resource.data.proofId;
      return proofId is string
        && proofId.matches('^dprf_.*')
        && getAfter(/databases/$(database)/documents/driver_proofs/$(proofId)).data.keyHash is string
        && isDriverKeyActive(getAfter(/databases/$(database)/documents/driver_proofs/$(proofId)).data.keyHash);
    }

    function hasValidWarehouseProof() {
      let proofId = request.resource.data.proofId;
      return proofId is string
        && proofId.matches('^wprf_.*')
        && getAfter(/databases/$(database)/documents/warehouse_proofs/$(proofId)).data.keyHash is string
        && isWarehouseKeyActive(getAfter(/databases/$(database)/documents/warehouse_proofs/$(proofId)).data.keyHash);
    }

    function hasValidSuperadminProof() {
      let proofId = request.resource.data.proofId;
      return proofId is string
        && proofId.matches('^sprf_.*')
        && getAfter(/databases/$(database)/documents/superadmin_proofs/$(proofId)).data.keyHash is string
        && isSuperadminKeyActive(getAfter(/databases/$(database)/documents/superadmin_proofs/$(proofId)).data.keyHash);
    }

    // Llaves maestras Admin (SHA-256)
    match /admin_keys/{keyHash} {
      allow get: if true;
      allow list: if false;
      allow create: if !exists(/databases/$(database)/documents/settings/security_init)
        || hasValidAdminProof();
      allow update: if hasValidAdminProof();
      allow delete: if false;
    }

    match /admin_proofs/{proofId} {
      allow read: if false;
      allow create: if request.resource.data.keyHash is string
        && isAdminKeyActive(request.resource.data.keyHash);
      allow update, delete: if false;
    }

    // Llaves PIN Choferes (SHA-256 de chofer + PIN)
    match /driver_keys/{keyHash} {
      allow get: if true;
      allow list: if false;
      allow create, update: if hasValidAdminProof();
      allow delete: if false;
    }

    match /driver_proofs/{proofId} {
      allow read: if false;
      allow create: if request.resource.data.keyHash is string
        && isDriverKeyActive(request.resource.data.keyHash);
      allow update, delete: if false;
    }

    // Llaves PIN Almacenistas (SHA-256)
    match /warehouse_keys/{keyHash} {
      allow get: if true;
      allow list: if false;
      allow create, update: if hasValidAdminProof() || hasValidSuperadminProof();
      allow delete: if false;
    }

    match /warehouse_proofs/{proofId} {
      allow read: if false;
      allow create: if request.resource.data.keyHash is string
        && isWarehouseKeyActive(request.resource.data.keyHash);
      allow update, delete: if false;
    }

    // Llave maestra Superadmin (SHA-256)
    match /superadmin_keys/{keyHash} {
      allow get: if true;
      allow list: if false;
      allow create: if !exists(/databases/$(database)/documents/settings/superadmin_init)
        || hasValidSuperadminProof();
      allow update: if hasValidSuperadminProof();
      allow delete: if false;
    }

    match /superadmin_proofs/{proofId} {
      allow read: if false;
      allow create: if request.resource.data.keyHash is string
        && isSuperadminKeyActive(request.resource.data.keyHash);
      allow update, delete: if false;
    }

    // Configuración pública del catálogo, precios y lista de choferes
    match /settings/{docId} {
      allow read: if true;
      allow create: if (docId == 'security_init'
        && !exists(/databases/$(database)/documents/settings/security_init))
        || (docId == 'superadmin_init'
        && !exists(/databases/$(database)/documents/settings/superadmin_init));
      allow write: if docId != 'security_init' && docId != 'superadmin_init'
        && (hasValidAdminProof() || hasValidSuperadminProof());
    }

    // Control Diario de Almacén
    match /warehouse_days/{dateId} {
      allow read: if true;
      allow write: if hasValidAdminProof() || hasValidWarehouseProof() || hasValidSuperadminProof();
    }

    // Termos y Tarimas / Lotes QR (Cuartos Fríos y Conversión de Proceso)
    match /thermos/{thermoId} {
      allow read: if true;
      allow create, update: if hasValidAdminProof() || hasValidWarehouseProof() || hasValidSuperadminProof();
      allow delete: if false;
    }

    match /pallet_lots/{lotId} {
      allow read: if true;
      allow create, update: if hasValidAdminProof() || hasValidWarehouseProof() || hasValidDriverProof() || hasValidSuperadminProof();
      allow delete: if false;
    }

    // Finanzas Superadmin (Precios de compra por termo y Gastos operativos)
    match /thermo_costs/{thermoId} {
      allow read: if true;
      allow create, update: if hasValidSuperadminProof();
      allow delete: if false;
    }

    match /expenses/{expenseId} {
      allow read: if true;
      allow create, update: if hasValidSuperadminProof();
      allow delete: if false;
    }

    // Ubicación GPS en tiempo real de cada chofer
    match /driver_locations/{driverId} {
      allow read: if true;
      allow write: if hasValidDriverProof() || hasValidAdminProof();
    }

    // Rutas activas armadas por Admin o Chofer (con secuencia OSRM y regreso a Base)
    match /driver_routes/{routeId} {
      allow read: if true;
      allow create, update: if hasValidAdminProof() || hasValidDriverProof();
      allow delete: if false;
    }

    // Tokens Web Push (FCM) de choferes: solo escritura del chofer, lectura bloqueada al público
    match /driver_push_tokens/{driverId} {
      allow read: if false;
      allow create, update: if hasValidDriverProof();
      allow delete: if false;
    }

    // Ventas registradas en ruta por los choferes (Contado, Transferencia o Crédito/Anticipo)
    match /route_sales/{saleId} {
      allow read: if true;
      allow create, update: if hasValidDriverProof() || hasValidAdminProof() || hasValidWarehouseProof();
      allow delete: if false;
    }

    // Puntos de compra registrados (Tiendas, Carnicerías, Restaurantes, Fruterías, etc.)
    match /places/{placeId} {
      allow read: if true;
      allow create, update: if hasValidDriverProof() || hasValidAdminProof() || hasValidWarehouseProof();
      allow delete: if false;
    }

    // Bitácora diaria de visitas en ruta (con o sin venta, validadas por GPS)
    match /place_visits/{visitId} {
      allow read: if true;
      allow create, update: if hasValidDriverProof() || hasValidAdminProof() || hasValidWarehouseProof();
      allow delete: if false;
    }

    // Pedidos en línea
    match /orders/{orderId} {
      allow read: if true;

      allow create: if request.resource.data.status == 'nuevo'
        && request.resource.data.customerName is string
        && request.resource.data.customerName.size() >= 2
        && request.resource.data.customerName.size() <= 120
        && request.resource.data.phone is string
        && request.resource.data.phone.size() >= 8
        && request.resource.data.phone.size() <= 25
        && request.resource.data.totalBoxes is number
        && request.resource.data.totalBoxes >= 1
        && request.resource.data.totalBoxes <= 2000
        && request.resource.data.totalAmount is number
        && request.resource.data.totalAmount >= 0;

      // Admin o Chofer autenticado pueden actualizar estatus de entrega
      allow update: if hasValidAdminProof() || hasValidDriverProof();
      allow delete: if false;
    }
  }
}
