rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // =========================================================================
    // A. MULTI-TENANT CRYPTOGRAPHIC VAULT & CAPABILITY HELPERS (RUTA PRO DIST.)
    // =========================================================================
    function isValidVaultIdFormat(vaultId) {
      return vaultId is string && vaultId.size() >= 20 && vaultId.matches('^vlt_.*');
    }

    function isTenantActive(tenantSlug) {
      let pubDoc = get(/databases/$(database)/documents/tenants/$(tenantSlug)/public/storefront);
      return pubDoc == null || pubDoc.data.tenantStatus != 'suspended';
    }

    function isTenantRoleKeyActiveForVault(tenantSlug, roleCol, keyHash, expectedVaultId) {
      let keyDoc = getAfter(/databases/$(database)/documents/tenants/$(tenantSlug)/$(roleCol)/$(keyHash));
      return keyDoc != null
        && keyDoc.data.active == true
        && keyDoc.data.vaultId == expectedVaultId
        && isTenantActive(tenantSlug);
    }

    function isTenantRoleKeyActive(tenantSlug, roleCol, keyHash) {
      let keyDoc = getAfter(/databases/$(database)/documents/tenants/$(tenantSlug)/$(roleCol)/$(keyHash));
      return keyDoc != null
        && keyDoc.data.active == true
        && isTenantActive(tenantSlug);
    }

    function hasValidTenantProofForCol(tenantSlug, proofCol, roleKeyCol, prefixPattern) {
      let proofId = request.resource.data.proofId;
      return proofId is string
        && proofId.matches(prefixPattern)
        && getAfter(/databases/$(database)/documents/tenants/$(tenantSlug)/$(proofCol)/$(proofId)).data.keyHash is string
        && isTenantRoleKeyActive(
          tenantSlug,
          roleKeyCol,
          getAfter(/databases/$(database)/documents/tenants/$(tenantSlug)/$(proofCol)/$(proofId)).data.keyHash
        );
    }

    function hasValidVaultProof(vaultId, proofCol, roleKeyCol, prefixPattern) {
      let proofId = request.resource.data.proofId;
      let tSlug = request.resource.data.tenantSlug is string
        ? request.resource.data.tenantSlug
        : get(/databases/$(database)/documents/vaults_meta/$(vaultId)).data.tenantSlug;
      return isValidVaultIdFormat(vaultId)
        && proofId is string
        && proofId.matches(prefixPattern)
        && tSlug is string
        && getAfter(/databases/$(database)/documents/tenants/$(tSlug)/$(proofCol)/$(proofId)).data.vaultId == vaultId
        && isTenantRoleKeyActiveForVault(
          tSlug,
          roleKeyCol,
          getAfter(/databases/$(database)/documents/tenants/$(tSlug)/$(proofCol)/$(proofId)).data.keyHash,
          vaultId
        );
    }

    function hasVaultAdminProof(vaultId) {
      return hasValidVaultProof(vaultId, 'admin_proofs', 'admin_keys', '^prf_.*');
    }
    function hasVaultDriverProof(vaultId) {
      return hasValidVaultProof(vaultId, 'driver_proofs', 'driver_keys', '^dprf_.*');
    }
    function hasVaultWarehouseProof(vaultId) {
      return hasValidVaultProof(vaultId, 'warehouse_proofs', 'warehouse_keys', '^wprf_.*');
    }
    function hasVaultOwnerProof(vaultId) {
      return hasValidVaultProof(vaultId, 'superadmin_proofs', 'superadmin_keys', '^sprf_.*');
    }

    // =========================================================================
    // B. SERVER-ONLY SAAS REGISTRY & METADATA (CLOUD FUNCTIONS ONLY)
    // =========================================================================
    match /saas_config/{docId} {
      allow read, write: if false;
    }
    match /saas_master_keys/{keyHash} {
      allow read, write: if false;
    }
    match /saas_tenants_registry/{tenantSlug} {
      allow read, write: if false;
    }
    match /tenants_private/{tenantSlug} {
      allow read, write: if false;
    }
    match /vaults_meta/{vaultId} {
      allow read, write: if false;
    }
    match /tenant_domains/{domainId} {
      allow get: if true;
      allow list, write: if false;
    }

    // =========================================================================
    // C. TENANT PUBLIC SURFACE & CAPABILITY AUTH KEYS (/tenants/{tenantSlug})
    // =========================================================================
    match /tenants/{tenantSlug} {
      allow read, write: if false;

      match /public/storefront {
        allow get: if true;
        allow list: if false;
        allow write: if hasValidTenantProofForCol(tenantSlug, 'admin_proofs', 'admin_keys', '^prf_.*')
          || hasValidTenantProofForCol(tenantSlug, 'superadmin_proofs', 'superadmin_keys', '^sprf_.*');
      }

      match /public_order_tracking/{orderId} {
        allow get: if true;
        allow list: if false;
        allow write: if false;
      }

      match /meta/{docId} {
        allow get: if true;
        allow list: if false;
        allow create: if (docId == 'security_init' && !exists(/databases/$(database)/documents/tenants/$(tenantSlug)/meta/security_init))
          || (docId == 'superadmin_init' && !exists(/databases/$(database)/documents/tenants/$(tenantSlug)/meta/superadmin_init));
        allow update, delete: if false;
      }

      match /admin_keys/{keyHash} {
        allow get: if true;
        allow list: if false;
        allow create: if !exists(/databases/$(database)/documents/tenants/$(tenantSlug)/meta/security_init)
          || hasValidTenantProofForCol(tenantSlug, 'admin_proofs', 'admin_keys', '^prf_.*');
        allow update: if hasValidTenantProofForCol(tenantSlug, 'admin_proofs', 'admin_keys', '^prf_.*');
        allow delete: if false;
      }

      match /admin_proofs/{proofId} {
        allow read: if false;
        allow create: if request.resource.data.keyHash is string
          && isTenantRoleKeyActive(tenantSlug, 'admin_keys', request.resource.data.keyHash);
        allow update, delete: if false;
      }

      match /driver_keys/{keyHash} {
        allow get: if true;
        allow list: if false;
        allow create, update: if hasValidTenantProofForCol(tenantSlug, 'admin_proofs', 'admin_keys', '^prf_.*');
        allow delete: if false;
      }

      match /driver_proofs/{proofId} {
        allow read: if false;
        allow create: if request.resource.data.keyHash is string
          && isTenantRoleKeyActive(tenantSlug, 'driver_keys', request.resource.data.keyHash);
        allow update, delete: if false;
      }

      match /warehouse_keys/{keyHash} {
        allow get: if true;
        allow list: if false;
        allow create, update: if hasValidTenantProofForCol(tenantSlug, 'admin_proofs', 'admin_keys', '^prf_.*')
          || hasValidTenantProofForCol(tenantSlug, 'superadmin_proofs', 'superadmin_keys', '^sprf_.*');
        allow delete: if false;
      }

      match /warehouse_proofs/{proofId} {
        allow read: if false;
        allow create: if request.resource.data.keyHash is string
          && isTenantRoleKeyActive(tenantSlug, 'warehouse_keys', request.resource.data.keyHash);
        allow update, delete: if false;
      }

      match /superadmin_keys/{keyHash} {
        allow get: if true;
        allow list: if false;
        allow create: if !exists(/databases/$(database)/documents/tenants/$(tenantSlug)/meta/superadmin_init)
          || hasValidTenantProofForCol(tenantSlug, 'superadmin_proofs', 'superadmin_keys', '^sprf_.*');
        allow update: if hasValidTenantProofForCol(tenantSlug, 'superadmin_proofs', 'superadmin_keys', '^sprf_.*');
        allow delete: if false;
      }

      match /superadmin_proofs/{proofId} {
        allow read: if false;
        allow create: if request.resource.data.keyHash is string
          && isTenantRoleKeyActive(tenantSlug, 'superadmin_keys', request.resource.data.keyHash);
        allow update, delete: if false;
      }
    }

    // =========================================================================
    // D. ISOLATED OPERATIONAL VAULTS (/vaults/{vaultId}) — ZERO CROSS-TENANT LEAKS
    // =========================================================================
    match /vaults/{vaultId} {
      allow read, write: if false;

      match /settings/{docId} {
        allow read: if isValidVaultIdFormat(vaultId);
        allow write: if hasVaultAdminProof(vaultId) || hasVaultOwnerProof(vaultId);
      }

      match /warehouse_days/{dateId} {
        allow read: if isValidVaultIdFormat(vaultId);
        allow write: if hasVaultAdminProof(vaultId) || hasVaultWarehouseProof(vaultId) || hasVaultOwnerProof(vaultId);
      }

      match /thermos/{thermoId} {
        allow read: if isValidVaultIdFormat(vaultId);
        allow create, update: if hasVaultAdminProof(vaultId) || hasVaultWarehouseProof(vaultId) || hasVaultOwnerProof(vaultId);
        allow delete: if false;
      }

      match /pallet_lots/{lotId} {
        allow read: if isValidVaultIdFormat(vaultId);
        allow create, update: if hasVaultAdminProof(vaultId) || hasVaultWarehouseProof(vaultId) || hasVaultDriverProof(vaultId) || hasVaultOwnerProof(vaultId);
        allow delete: if false;
      }

      match /thermo_costs/{thermoId} {
        allow read: if isValidVaultIdFormat(vaultId);
        allow create, update: if hasVaultOwnerProof(vaultId);
        allow delete: if false;
      }

      match /expenses/{expenseId} {
        allow read: if isValidVaultIdFormat(vaultId);
        allow create, update: if hasVaultOwnerProof(vaultId);
        allow delete: if false;
      }

      match /driver_locations/{driverId} {
        allow read: if isValidVaultIdFormat(vaultId);
        allow write: if hasVaultDriverProof(vaultId) || hasVaultAdminProof(vaultId);
      }

      match /driver_routes/{routeId} {
        allow read: if isValidVaultIdFormat(vaultId);
        allow create, update: if hasVaultAdminProof(vaultId) || hasVaultDriverProof(vaultId);
        allow delete: if false;
      }

      match /driver_push_tokens/{driverId} {
        allow read: if false;
        allow create, update: if hasVaultDriverProof(vaultId);
        allow delete: if false;
      }

      match /route_sales/{saleId} {
        allow read: if isValidVaultIdFormat(vaultId);
        allow create, update: if hasVaultDriverProof(vaultId) || hasVaultAdminProof(vaultId) || hasVaultWarehouseProof(vaultId);
        allow delete: if false;
      }

      match /places/{placeId} {
        allow read: if isValidVaultIdFormat(vaultId);
        allow create, update: if hasVaultDriverProof(vaultId) || hasVaultAdminProof(vaultId) || hasVaultWarehouseProof(vaultId);
        allow delete: if false;
      }

      match /place_visits/{visitId} {
        allow read: if isValidVaultIdFormat(vaultId);
        allow create, update: if hasVaultDriverProof(vaultId) || hasVaultAdminProof(vaultId) || hasVaultWarehouseProof(vaultId);
        allow delete: if false;
      }

      match /orders/{orderId} {
        allow read: if isValidVaultIdFormat(vaultId);
        allow create, update: if hasVaultAdminProof(vaultId) || hasVaultDriverProof(vaultId);
        allow delete: if false;
      }
    }

    // =========================================================================
    // E. LEGACY ROOT TRANSITIONAL FALLBACK (FOR OPEN TABS DURING CUTOVER)
    // =========================================================================
    function isLegacyAdminKeyActive(keyHash) {
      let keyDoc = getAfter(/databases/$(database)/documents/admin_keys/$(keyHash));
      return keyDoc != null && keyDoc.data.active == true;
    }
    function isLegacyDriverKeyActive(keyHash) {
      let keyDoc = getAfter(/databases/$(database)/documents/driver_keys/$(keyHash));
      return keyDoc != null && keyDoc.data.active == true;
    }
    function hasLegacyAdminProof() {
      let proofId = request.resource.data.proofId;
      return proofId is string && proofId.matches('^prf_.*')
        && isLegacyAdminKeyActive(getAfter(/databases/$(database)/documents/admin_proofs/$(proofId)).data.keyHash);
    }
    function hasLegacyDriverProof() {
      let proofId = request.resource.data.proofId;
      return proofId is string && proofId.matches('^dprf_.*')
        && isLegacyDriverKeyActive(getAfter(/databases/$(database)/documents/driver_proofs/$(proofId)).data.keyHash);
    }

    match /admin_keys/{keyHash} { allow get: if true; allow list, write: if false; }
    match /driver_keys/{keyHash} { allow get: if true; allow list, write: if false; }
    match /warehouse_keys/{keyHash} { allow get: if true; allow list, write: if false; }
    match /superadmin_keys/{keyHash} { allow get: if true; allow list, write: if false; }
    match /admin_proofs/{proofId} { allow read: if false; allow create: if isLegacyAdminKeyActive(request.resource.data.keyHash); }
    match /driver_proofs/{proofId} { allow read: if false; allow create: if isLegacyDriverKeyActive(request.resource.data.keyHash); }
    match /settings/{docId} { allow read: if true; allow write: if false; }
    match /driver_locations/{driverId} { allow read: if true; allow write: if hasLegacyDriverProof() || hasLegacyAdminProof(); }
    match /place_visits/{visitId} { allow read: if true; allow create, update: if hasLegacyDriverProof() || hasLegacyAdminProof(); }
  }
}
